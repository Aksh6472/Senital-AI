# ── Database ────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel_ai

# ── JWT ─────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-real-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── App ─────────────────────────────────────────────────────────
APP_NAME=Sentinel AI
APP_VERSION=0.1.0
DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]

# ── Notification Channels (Phase 2 adapters, configure per provider)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@sentinel-ai.local

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Evidence Storage (S3-compatible) ────────────────────────────
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=sentinel-evidence
